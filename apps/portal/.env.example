# Copia este archivo a .env (nunca se versiona) y completa los valores.

# Django
# Clave obligatoria si DJANGO_DEBUG=False (sin ella el portal no arranca). Para generarla:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# En local: DJANGO_DEBUG=True (usa una clave de desarrollo y acepta localhost)
DJANGO_DEBUG=False
# Dominios separados por coma, p. ej. portal.empresabkb.cl (con DEBUG=True no hace falta)
DJANGO_ALLOWED_HOSTS=

# Base de datos (vacío en local = SQLite)
DATABASE_URL=

# DigitalOcean Space (clave dedicada al portal, no la personal)
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=bkb-space
SPACES_REGION=nyc3
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# Desarrollo: portal-dev/ · Producción: portal/
SPACES_PREFIX=portal-dev/

# Límite de subida por archivo, en MB
MAX_UPLOAD_MB=50
