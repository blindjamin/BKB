---
import '../styles/global.css';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import WhatsAppButton from '../components/site/WhatsAppButton.astro';
import EmergencyNotice from '../components/site/EmergencyNotice.astro';
import { getPath } from '../utils/paths';
import { SITE } from '../config/site';

interface Props {
  title: string;
  description?: string;
  headerMode?: 'reveal' | 'solid';
}

const { 
  title, 
  description = "BKB · Obras Eléctricas & Servicios. Más de 30 años en ingeniería eléctrica, automatización, canalizaciones y tableros industriales en Chile. Certificación SEC Clase A.",
  headerMode = 'solid'
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = Astro.site || 'https://www.bkb.cl';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();

// Schema.org LocalBusiness actualizado
const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "Electrician",
  "name": SITE.name,
  "url": siteUrl.toString(),
  "logo": new URL(getPath('/logo.svg'), siteUrl).toString(),
  "description": description,
  "areaServed": SITE.coverage,
  "hasCredential": "SEC Clase A",
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": SITE.phoneDisplay,
    "contactType": "customer service",
    "availableLanguage": "Spanish"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "El Parque 110",
    "addressLocality": "La Calera",
    "addressRegion": "Valparaíso",
    "addressCountry": "CL"
  }
};
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const t = localStorage.getItem('bkb-theme');
        if (t === 'light' || t === 'dark') {
          document.documentElement.dataset.theme = t;
        }
      } catch (e) {}
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#18181A" />
    
    <link rel="icon" type="image/svg+xml" href={getPath('/favicon.svg')} />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@600;700;800&display=swap" rel="stylesheet" />
    
    <title>{title} | {SITE.name}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Redes -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | ${SITE.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="es_CL" />

    <!-- Datos estructurados SEO -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  </head>
  <body class="bg-page text-main font-sans">
    <!-- Enlace de salto accesible para WCAG 2.2 AA -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-salmon-500 focus:text-white focus:px-4 focus:py-2 focus:rounded-md focus:shadow-lg focus:outline-none">
      Saltar al contenido principal
    </a>

    <SiteHeader mode={headerMode} />

    <main id="main-content" class="flex-1 flex flex-col">
      <slot />
    </main>

    <SiteFooter />
    <EmergencyNotice />
    <WhatsAppButton />
    
    <script src="../scripts/theme.ts"></script>
    <script src="../scripts/motion.ts"></script>
  </body>
</html>
