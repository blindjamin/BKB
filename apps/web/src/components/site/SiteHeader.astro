---
import ThemeToggle from './ThemeToggle.astro';
import MobileNav from './MobileNav.astro';
import { getPath } from '../../utils/paths';
import { PORTAL_URLS } from '../../config/site';

interface Props {
  mode?: 'reveal' | 'solid';
}

const { mode = 'solid' } = Astro.props;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/BKB/';
const navLinks = [
  { href: isHome ? '#top' : getPath('/'), label: 'Inicio' },
  { href: isHome ? '#nosotros' : `${getPath('/')}#nosotros`, label: 'Nosotros' },
  { href: isHome ? '#mercados' : `${getPath('/')}#mercados`, label: 'Mercados' },
  { href: isHome ? '#servicios' : `${getPath('/')}#servicios`, label: 'Servicios' },
  { href: isHome ? '#obras' : `${getPath('/')}#obras`, label: 'Obras' },
  { href: isHome ? '#portal' : `${getPath('/')}#portal`, label: 'Portal SEC' },
  { href: isHome ? '#cotizar' : `${getPath('/')}#cotizar`, label: 'Contacto' },
];

const headerClasses = mode === 'reveal' 
  ? 'site-header-reveal fixed top-0 left-0 right-0 z-50 pointer-events-none opacity-0 -translate-y-full'
  : 'site-header-solid sticky top-0 z-50 transition-colors duration-300 backdrop-blur-md border-b bg-page/95 border-card-border shadow-sm';
---

<header class={headerClasses} id="site-header" data-mode={mode}>
  <div class="mx-auto flex items-center justify-between flex-nowrap" style="max-width: var(--bkb-container); padding: 14px 40px;">
    
    <div class="flex items-center gap-3.5">
      <a href={getPath('/')} class="focus-bkb rounded-sm block">
        <img src={getPath('/assets/bkb-logo-final.png')} alt="BKB Ingeniería Eléctrica & Servicios" width="auto" height="44" class="h-[44px] w-auto object-contain" />
      </a>
    </div>

    <nav class="hidden xl:flex items-center gap-[30px]" aria-label="Navegación principal">
      {navLinks.map(link => (
        <a
          href={link.href}
          data-navlink={link.href.replace(/^.*#/, '')}
          class="navlink relative text-main font-medium text-sm transition-colors hover:text-salmon-500 focus-bkb rounded-sm p-1"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <ThemeToggle />
      
      <a href={PORTAL_URLS.home} class="hidden xl:inline-flex items-center gap-2 px-[18px] py-[10px] rounded-pill bg-card border border-card-border text-main text-sm font-semibold transition-colors hover:border-salmon-500 hover:text-salmon-500 focus-bkb">
        Acceso Portal
      </a>
      
      <a href={isHome ? '#cotizar' : `${getPath('/')}#cotizar`} class="inline-flex items-center px-5 py-[10px] rounded-pill bg-salmon-500 text-white text-sm font-semibold transition-transform hover:-translate-y-0.5 focus-bkb whitespace-nowrap">
        Cotizar Obra
      </a>
      
      <!-- Menú Móvil -->
      <MobileNav links={navLinks} />
    </div>
  </div>
</header>

<style>
  .site-header-reveal {
    transition: background-color 0.3s ease, border-color 0.3s ease, opacity 0.3s ease, transform 0.3s ease, visibility 0s linear 0.3s;
    visibility: hidden;
  }
  .site-header-reveal.is-scrolled,
  .site-header-reveal:focus-within {
    background-color: rgba(8, 12, 20, 0.6);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    visibility: visible;
    transition-delay: 0s, 0s, 0s, 0s, 0s;
  }
  
  :global(html[data-theme="light"]) .site-header-reveal.is-scrolled,
  :global(html[data-theme="light"]) .site-header-reveal:focus-within {
    background-color: rgba(255, 244, 238, 0.8);
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  @media (max-width: 640px) {
    header > div {
      padding: 14px 16px !important;
    }
  }

  .navlink::after {
    content: '';
    position: absolute;
    left: 4px;
    right: 4px;
    bottom: -2px;
    height: 2px;
    border-radius: 2px;
    background: var(--bkb-salmon-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .navlink:hover::after,
  .navlink.is-active::after {
    transform: scaleX(1);
  }
  .navlink.is-active {
    color: var(--bkb-salmon-500);
  }
</style>

<script>
  function initActiveNav() {
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.navlink[data-navlink]');
    if (!navLinks.length) return;

    const sections: { id: string; el: Element; link: HTMLAnchorElement }[] = [];
    navLinks.forEach(link => {
      const id = link.dataset.navlink;
      if (!id) return;
      const el = document.getElementById(id);
      if (el) sections.push({ id, el, link });
    });
    if (!sections.length) return;

    const setActive = (id: string | null) => {
      navLinks.forEach(link => {
        link.classList.toggle('is-active', link.dataset.navlink === id);
      });
    };

    const observer = new IntersectionObserver((entries) => {
      const visible = entries
        .filter(e => e.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
      if (visible.length > 0) {
        const match = sections.find(s => s.el === visible[0].target);
        if (match) setActive(match.id);
      }
    }, { rootMargin: '-45% 0px -45% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] });

    sections.forEach(s => observer.observe(s.el));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initActiveNav);
  } else {
    initActiveNav();
  }
</script>
