---
import ThemeToggle from './ThemeToggle.astro';
import MobileNav from './MobileNav.astro';
import { getPath } from '../../utils/paths';
import { PORTAL_URLS } from '../../config/site';

interface Props {
  mode?: 'reveal' | 'solid';
}

const { mode = 'solid' } = Astro.props;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/BKB/';
const cotizarHref = isHome ? '#cotizar' : `${getPath('/')}#cotizar`;
// Astro.url.pathname puede venir con barra final en el build: se quita para comparar
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const navLinks = [
  { href: isHome ? '#top' : getPath('/'), label: 'Inicio' },
  { href: isHome ? '#servicios' : `${getPath('/')}#servicios`, label: 'Servicios' },
  { href: getPath('/arriendo'), label: 'Arriendo', badge: 'Nuevo' },
  { href: isHome ? '#mercados' : `${getPath('/')}#mercados`, label: 'Mercados' },
  { href: isHome ? '#testimonios' : `${getPath('/')}#testimonios`, label: 'Testimonios' },
  { href: isHome ? '#obras' : `${getPath('/')}#obras`, label: 'Obras' },
  { href: isHome ? '#cotizar' : `${getPath('/')}#cotizar`, label: 'Contacto' },
].map((link) => ({ ...link, current: link.href === currentPath }));

const headerClasses = mode === 'reveal'
  ? 'site-header-reveal fixed top-0 left-0 right-0 z-50'
  : 'site-header-solid sticky top-0 z-50 transition-colors duration-300 backdrop-blur-md border-b bg-page/95 border-card-border shadow-sm';
---

<header class={headerClasses} id="site-header" data-mode={mode}>
  <div class="mx-auto flex items-center justify-between flex-nowrap" style="max-width: var(--bkb-container); padding: 14px 40px;">

    <div class="flex items-center gap-3.5">
      {!isHome && (
        <a href={getPath('/')} class="focus-bkb rounded-sm block">
          <img src={getPath('/assets/bkb-logo-final.png')} alt="BKB Ingeniería Eléctrica & Servicios" width="auto" height="52" class="h-[52px] w-auto object-contain" />
        </a>
      )}
    </div>

    <nav class="hidden xl:flex items-center gap-[24px]" aria-label="Navegación principal">
      {navLinks.map(link => (
        <a
          href={link.href}
          aria-current={link.current ? 'page' : undefined}
          data-navlink={link.href.replace(/^.*#/, '')}
          class="nav-link navlink relative font-semibold text-sm transition-colors focus-bkb rounded-sm p-1"
        >
          {link.label}
          {link.badge && <span class="ml-1.5 align-middle rounded-pill bg-salmon-700 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">{link.badge}</span>}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <ThemeToggle />

      <a href={PORTAL_URLS.cliente} class="header-pill cta-pulse inline-flex items-center gap-2 whitespace-nowrap px-[18px] py-[10px] rounded-pill bg-[rgba(255,255,255,0.06)] border border-[rgba(255,255,255,0.2)] text-main text-sm font-semibold backdrop-blur-[8px] transition-colors hover:border-salmon-500 hover:text-salmon-500 focus-bkb">
        Soy cliente <span class="cta-flecha" aria-hidden="true">&rarr;</span>
      </a>

      <a href={cotizarHref} class="hidden xl:inline-flex items-center px-5 py-[10px] rounded-pill bg-salmon-500 text-white text-sm font-semibold transition-transform hover:-translate-y-0.5 focus-bkb whitespace-nowrap">
        Cotizar Obra
      </a>

      <!-- Menú Móvil -->
      <MobileNav links={navLinks} cotizarHref={cotizarHref} />
    </div>
  </div>
</header>

<style>
  /* Colores del header según fondo. Por defecto: fondo oscuro -> texto claro. */
  #site-header {
    --hdr-text: #F8FAFC;
    --hdr-hover: var(--bkb-salmon-300);
    --hdr-active: var(--bkb-salmon-300);
    --pill-bg: rgba(255, 255, 255, 0.1);
    --pill-border: rgba(255, 255, 255, 0.35);
  }
  /* En los dos temas el header es oscuro y con texto claro. En el tema claro va en grafito
     con una línea naranja, igual que el portal. */
  :global(html[data-theme="dark"]) #site-header.site-header-solid {
    background-color: rgba(30, 30, 33, 0.92);
    border-color: rgba(255, 255, 255, 0.1);
  }
  :global(html[data-theme="light"]) #site-header.site-header-solid {
    background-color: rgba(15, 23, 42, 0.96);
    border-bottom: 3px solid var(--bkb-salmon-500);
  }

  .nav-link {
    color: var(--hdr-text);
  }
  .nav-link:hover {
    color: var(--hdr-hover);
  }
  #site-header :global(.header-pill) {
    color: var(--hdr-text);
    background: var(--pill-bg);
    border-color: var(--pill-border);
  }
  #site-header :global(.header-pill:hover) {
    color: var(--hdr-hover);
    border-color: var(--hdr-hover);
  }

  /* Modo reveal (inicio): visible siempre; transparente sobre el hero y con fondo
     al llegar a "Qué hacemos" (motion.ts pone .is-scrolled) */
  .site-header-reveal {
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .site-header-reveal.is-scrolled {
    background: rgba(8, 12, 20, 0.88);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
  }

  :global(html[data-theme="light"]) .site-header-reveal.is-scrolled {
    background: rgba(15, 23, 42, 0.94);
    border-bottom: 3px solid var(--bkb-salmon-500);
  }

  /* "Soy cliente": barrido salmón cada 2 s y flecha que empuja, tipo "clickea aquí" */
  #site-header :global(.cta-pulse) {
    border-color: var(--bkb-salmon-500);
    background-image: linear-gradient(110deg, transparent 30%, rgba(250, 90, 54, 0.85) 50%, transparent 70%);
    background-size: 250% 100%;
    background-repeat: no-repeat;
    background-position: 150% 0;
  }
  :global(.cta-pulse) {
    animation: cta-barrido 2s ease-in-out infinite;
  }
  :global(.cta-flecha) {
    display: inline-block;
    color: var(--bkb-salmon-500);
    animation: cta-flecha 1s ease-in-out infinite;
  }
  :global(.cta-pulse:hover),
  :global(.cta-pulse:focus-visible),
  :global(.cta-pulse:hover .cta-flecha),
  :global(.cta-pulse:focus-visible .cta-flecha) {
    animation: none;
  }
  @keyframes cta-barrido {
    0%, 40% { background-position: 150% 0; }
    100% { background-position: -50% 0; }
  }
  @keyframes cta-flecha {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header-reveal { transition: none; }
    :global(.cta-pulse), :global(.cta-flecha) { animation: none; }
  }

  @media (max-width: 640px) {
    header > div {
      padding: 14px 16px !important;
    }
  }

  .navlink::after {
    content: '';
    position: absolute;
    left: 4px;
    right: 4px;
    bottom: -2px;
    height: 2px;
    border-radius: 2px;
    background: var(--bkb-salmon-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .navlink:hover::after,
  .navlink.is-active::after,
  .navlink[aria-current="page"]::after {
    transform: scaleX(1);
  }
  .navlink.is-active,
  .navlink[aria-current="page"] {
    color: var(--hdr-active);
  }
</style>

<script>
  function initActiveNav() {
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.navlink[data-navlink]');
    if (!navLinks.length) return;

    const sections: { id: string; el: Element; link: HTMLAnchorElement }[] = [];
    navLinks.forEach(link => {
      const id = link.dataset.navlink;
      if (!id) return;
      const el = document.getElementById(id);
      if (el) sections.push({ id, el, link });
    });
    if (!sections.length) return;

    const setActive = (id: string | null) => {
      navLinks.forEach(link => {
        link.classList.toggle('is-active', link.dataset.navlink === id);
      });
    };

    const observer = new IntersectionObserver((entries) => {
      const visible = entries
        .filter(e => e.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
      if (visible.length > 0) {
        const match = sections.find(s => s.el === visible[0].target);
        if (match) setActive(match.id);
      }
    }, { rootMargin: '-45% 0px -45% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] });

    sections.forEach(s => observer.observe(s.el));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initActiveNav);
  } else {
    initActiveNav();
  }
</script>
