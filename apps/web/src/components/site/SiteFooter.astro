---
import { SITE, PORTAL_URLS } from '../../config/site';
import { getPath } from '../../utils/paths';

const year = new Date().getFullYear();
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/BKB/';
const serviciosHref = isHome ? '#servicios' : `${getPath('/')}#servicios`;
---

<footer class="bg-night-950 border-t border-[rgba(255,255,255,0.08)]">
  <div class="mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr] gap-10 px-5 sm:px-10 py-16" style="max-width: var(--bkb-container);">
    
    <div class="flex flex-col gap-3.5">
      <img src={getPath('/assets/bkb-logo-final.png')} alt={SITE.name} width="auto" height="56" class="h-[56px] w-auto object-contain self-start" />
      <p class="text-[13.5px] leading-relaxed text-[#8391A7] m-0 max-w-[32ch]">
        Más de 30 años de trayectoria en montaje eléctrico industrial y certificación SEC Clase A en Chile.
      </p>
    </div>
    
    <div class="flex flex-col gap-3">
      <span class="text-[13px] font-semibold text-[#F8FAFC]">Especialidades</span>
      <a href={serviciosHref} class="text-[13.5px] text-[#8391A7] no-underline hover:text-salmon-500 transition-colors focus-bkb rounded-sm inline-block self-start">Ingeniería Eléctrica</a>
      <a href={serviciosHref} class="text-[13.5px] text-[#8391A7] no-underline hover:text-salmon-500 transition-colors focus-bkb rounded-sm inline-block self-start">Automatización PLC</a>
      <a href={serviciosHref} class="text-[13.5px] text-[#8391A7] no-underline hover:text-salmon-500 transition-colors focus-bkb rounded-sm inline-block self-start">Obras Civiles</a>
      <a href={serviciosHref} class="text-[13.5px] text-[#8391A7] no-underline hover:text-salmon-500 transition-colors focus-bkb rounded-sm inline-block self-start">Mantención 24/7</a>
    </div>
    
    <div class="flex flex-col gap-3">
      <span class="text-[13px] font-semibold text-[#F8FAFC]">Plataforma</span>
      <a href={PORTAL_URLS.cliente} class="text-[13.5px] text-[#8391A7] no-underline hover:text-salmon-500 transition-colors focus-bkb rounded-sm inline-block self-start">Acceso Clientes</a>
      <a href={PORTAL_URLS.colaborador} class="text-[13.5px] text-[#8391A7] no-underline hover:text-salmon-500 transition-colors focus-bkb rounded-sm inline-block self-start">Acceso Colaboradores</a>
    </div>
    
    <div class="flex flex-col gap-3">
      <span class="text-[13px] font-semibold text-[#F8FAFC]">Contacto</span>
      <span class="text-[13.5px] text-[#8391A7]">{SITE.office}</span>
      <a href={SITE.phoneHref} class="text-[13.5px] text-[#8391A7] no-underline hover:text-salmon-500 transition-colors focus-bkb rounded-sm inline-block self-start">{SITE.phoneDisplay}</a>
      <a href={`mailto:${SITE.email}`} class="text-[13.5px] text-[#8391A7] no-underline hover:text-salmon-500 transition-colors focus-bkb rounded-sm inline-block self-start">{SITE.email}</a>
    </div>
    
  </div>
  
  <div class="mx-auto border-t border-[rgba(255,255,255,0.07)] flex items-center justify-between flex-wrap gap-3 px-5 sm:px-10 py-5" style="max-width: var(--bkb-container);">
    <span class="text-[12.5px] text-[#8391A7]">© {year} {SITE.name}</span>
    
    <div class="flex flex-wrap items-center gap-5">
      <a href={getPath('/trabaja-con-nosotros')} class="text-[12.5px] text-[#8391A7] no-underline hover:text-salmon-500 transition-colors focus-bkb rounded-sm">Trabaja con nosotros</a>
      <a href={getPath('/terminos')} class="text-[12.5px] text-[#8391A7] no-underline hover:text-salmon-500 transition-colors focus-bkb rounded-sm">Términos de Servicio</a>
      <a href={getPath('/privacidad')} class="text-[12.5px] text-[#8391A7] no-underline hover:text-salmon-500 transition-colors focus-bkb rounded-sm">Privacidad (Ley 21.719)</a>
      <a href={PORTAL_URLS.cliente} class="text-[12.5px] font-semibold text-salmon-300 no-underline hover:text-salmon-500 transition-colors focus-bkb rounded-sm">Portal de clientes →</a>
    </div>
  </div>
</footer>
