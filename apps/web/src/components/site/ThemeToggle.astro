---
---
<button 
  type="button" 
  data-theme-toggle 
  aria-label="Cambiar a tema claro" 
  title="Cambiar tema"
  class="inline-flex items-center justify-center shrink-0 w-[38px] h-[38px] rounded-pill bg-salmon-500/10 border border-salmon-500/30 text-salmon-500 cursor-pointer hover:bg-salmon-500/15 hover:border-salmon-500 transition-colors focus-bkb group"
>
  <!-- Icono Sol (se muestra en tema oscuro) -->
  <svg class="sun-icon hidden group-data-[theme=dark]:block" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>
  
  <!-- Icono Luna (se muestra en tema claro) -->
  <svg class="moon-icon hidden group-data-[theme=light]:block" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  /* Usamos estilos de estado global de html para ocultar/mostrar */
  :global(html[data-theme="dark"]) .sun-icon {
    display: block;
  }
  :global(html[data-theme="dark"]) .moon-icon {
    display: none;
  }
  
  :global(html[data-theme="light"]) .sun-icon {
    display: none;
  }
  :global(html[data-theme="light"]) .moon-icon {
    display: block;
  }
</style>
