---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow: string;
  title: string;
  desc?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, desc, align = 'left' } = Astro.props;
---

<div class={`max-w-[640px] mb-12 flex flex-col gap-3 ${align === 'center' ? 'mx-auto text-center items-center' : 'text-left items-start'}`}>
  <Eyebrow text={eyebrow} />
  <h2 class="font-display font-bold text-[length:var(--bkb-text-h2)] leading-[1.1] text-main m-0" set:html={title} />
  {desc && <p class="text-[16px] leading-[1.6] text-muted m-0">{desc}</p>}
</div>
