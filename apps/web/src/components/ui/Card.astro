---
interface Props {
  hover?: boolean;
  class?: string;
}
const { hover = false, class: className = '' } = Astro.props;

const baseClasses = "bg-card border border-card-border rounded-card p-[28px] relative overflow-hidden";
const hoverClasses = hover ? "transition-transform duration-300 hover:-translate-y-1 hover:shadow-xl" : "";
---

<div class={`${baseClasses} ${hoverClasses} ${className}`}>
  <slot />
</div>
