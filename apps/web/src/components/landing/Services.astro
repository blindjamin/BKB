---
import { Image } from 'astro:assets';
import { servicios } from '../../data/landing';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="servicios" class="py-24 max-w-[var(--bkb-container)] mx-auto px-5 sm:px-10 scroll-mt-[80px]">
  <div class="reveal">
    <SectionHeading eyebrow="QUÉ HACEMOS" title="Ingeniería integral para<br/>la continuidad operativa." />
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[22px]">
    {servicios.map((s, index) => (
      <div 
        class="reveal group bg-card border border-card-border rounded-card p-7 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:border-salmon-500/50 flex flex-col h-full"
        style={`transition-delay: ${index * 100}ms;`}
      >
        
        <div class="w-[52px] h-[52px] rounded-[13px] bg-salmon-300/15 mb-6 flex items-center justify-center overflow-hidden transition-transform duration-300 group-hover:scale-105 group-hover:-translate-y-1">
          <Image 
            src={s.icon} 
            alt="" 
            aria-hidden="true" 
            style={`width: ${s.iconSize}; height: ${s.iconSize}; object-fit: ${s.iconFit};`} 
            class={s.iconFit === 'cover' ? 'w-full h-full' : ''}
          />
        </div>
        
        <h3 class="font-display font-bold text-[20px] leading-[1.25] text-main mb-3">{s.title}</h3>
        <p class="text-[14.5px] leading-[1.55] text-muted m-0 mb-6 flex-1">{s.desc}</p>
        
        <div class="pt-5 border-t border-card-border mt-auto">
          <ul class="m-0 p-0 list-none flex flex-col gap-2">
            {s.bullets.map(b => (
              <li class="flex items-start gap-2 text-[13px] text-subtle font-medium">
                <span class="text-salmon-500 text-[14px] leading-tight" aria-hidden="true">✓</span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    ))}
  </div>
</section>
