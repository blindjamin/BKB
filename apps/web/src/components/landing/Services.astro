---
import { servicios } from '../../data/landing';
import SectionHeading from '../ui/SectionHeading.astro';

const icons = [
  // Ingeniería Eléctrica (rayo)
  '<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>',
  // Automatización & PLC (chip)
  '<rect x="6" y="6" width="12" height="12" rx="1.5"/><path d="M9 2v3"/><path d="M15 2v3"/><path d="M9 19v3"/><path d="M15 19v3"/><path d="M2 9h3"/><path d="M2 15h3"/><path d="M19 9h3"/><path d="M19 15h3"/>',
  // Obras Civiles Industriales (casco)
  '<path d="M12 4a8 8 0 0 0-8 8v2h16v-2a8 8 0 0 0-8-8Z"/><rect x="2" y="14" width="20" height="3" rx="1.5"/><path d="M12 4v4"/>',
  // Mantención & Guardia 24/7 (llave)
  '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
];
---

<section id="servicios" class="py-24 max-w-[var(--bkb-container)] mx-auto px-5 sm:px-10 scroll-mt-[80px]">
  <div class="reveal">
    <SectionHeading eyebrow="QUÉ HACEMOS" title="Ingeniería integral para<br/>la continuidad operativa." />
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[22px]">
    {servicios.map((s, index) => (
      <div 
        class="reveal group bg-card border border-card-border rounded-card p-7 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:border-salmon-500/50 flex flex-col h-full"
        style={`transition-delay: ${index * 100}ms;`}
      >
        
        <div class="w-[52px] h-[52px] rounded-[13px] bg-salmon-300/15 mb-6 flex items-center justify-center text-salmon-500 transition-transform duration-300 group-hover:scale-105 group-hover:-translate-y-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[index]} />
        </div>
        
        <h3 class="font-display font-bold text-[20px] leading-[1.25] text-main mb-3">{s.title}</h3>
        <p class="text-[14.5px] leading-[1.55] text-muted m-0 mb-6 flex-1">{s.desc}</p>
        
        <div class="pt-5 border-t border-card-border mt-auto">
          <ul class="m-0 p-0 list-none flex flex-col gap-2">
            {s.bullets.map(b => (
              <li class="flex items-start gap-2 text-[13px] text-subtle font-medium">
                <span class="text-salmon-500 text-[14px] leading-tight" aria-hidden="true">✓</span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    ))}
  </div>
</section>
