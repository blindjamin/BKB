---
import { Image } from 'astro:assets';
import { PORTAL_URLS } from '../../config/site';
import { getPath } from '../../utils/paths';
import faenaHero from '../../assets/landing/faena-hero.jpg';
---

<section id="top" class="relative w-full overflow-hidden flex items-center bg-night-900" style="min-height: calc(100svh - 310px);" aria-label="Hero">
  <div class="absolute inset-0 overflow-hidden">
    <Image 
      src={faenaHero} 
      alt="Técnico BKB en faena eléctrica industrial" 
      class="hero-bg-img w-full h-full object-cover" 
      loading="eager" 
      fetchpriority="high" 
    />
    <div class="absolute inset-0 bg-gradient-to-br from-night-900/90 via-night-900/70 to-night-900/50"></div>
  </div>

  <div class="relative z-10 mx-auto w-full px-4 sm:px-10 pt-[64px] pb-[64px] grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-14 items-start" style="max-width: var(--bkb-container);">

    <div class="flex flex-col gap-6 pt-5">
      <div class="hero-in inline-flex self-start items-center gap-2 bg-salmon-500/15 border border-salmon-500/40 text-salmon-300 text-[13px] font-semibold tracking-[0.02em] px-4 py-[9px] rounded-pill">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
          <path d="M11 21.9v-8.4H5.3c-.6 0-1-.6-.8-1.2l4.8-10.8c.2-.5.8-.8 1.4-.6.2.1.4.2.5.4l.2.4v7.9h5.3c.6 0 1 .6.8 1.2l-4.8 10.8c-.2.5-.8.8-1.4.6-.2-.1-.4-.2-.5-.3z"/>
        </svg>
        <span>Obras Eléctricas & Servicios Industriales · Más de 30 años de trayectoria</span>
      </div>

      <h1 class="hero-in font-display text-[length:var(--bkb-text-h1)] leading-[1.08] tracking-[-0.02em] m-0 font-extrabold text-[#F8FAFC]">
        Energía que<br/><span class="text-salmon-500">no se detiene.</span>
      </h1>

      <p class="hero-in text-[18px] leading-[1.6] text-[#94A3B8] m-0 max-w-[48ch]">
        Ingeniería de montaje, automatización PLC y mantenimiento eléctrico integral para plantas industriales en Chile. Garantía de continuidad operativa y certificación SEC TE1.
      </p>
    </div>

    <!-- Portal access card -->
    <div class="portal-card hero-in backdrop-blur-md border rounded-[20px] p-8 flex flex-col gap-5">
      <div class="flex items-center gap-3">
        <img src={getPath('/assets/bkb-logo-final.png')} alt="" aria-hidden="true" width="48" height="48" class="w-12 h-12 shrink-0 object-contain" />
        <div>
          <div class="portal-card-title font-display text-[17px] font-bold">Portal Digital BKB</div>
          <div class="portal-card-muted text-[12px]">Gestión Documental</div>
        </div>
      </div>
      
      <p class="portal-card-muted m-0 text-[14px] leading-[1.5]">
        Ingresa al portal para acceder a tu documentación.
      </p>

      <a href={PORTAL_URLS.cliente} class="flex items-center justify-center p-4 rounded-[10px] bg-salmon-500 text-white font-semibold text-[15px] no-underline transition-colors hover:bg-salmon-700 focus-bkb">
        Soy Cliente &rarr;
      </a>
    </div>
    
  </div>
</section>

<style>
  .hero-bg-img {
    animation: heroZoom 22s infinite alternate ease-in-out;
  }

  /* Tarjeta del portal: oscura en tema oscuro, naranjo suave en tema claro */
  .portal-card {
    /* Degradado carbón -> negro (antes azul marino) */
    background: linear-gradient(160deg, rgba(44, 44, 48, 0.82) 0%, rgba(22, 22, 24, 0.86) 60%, rgba(38, 24, 20, 0.86) 100%);
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6), 0 0 40px rgba(250, 90, 54, 0.12);
  }
  .portal-card-title { color: #F8FAFC; }
  .portal-card-muted { color: #A1A1AA; }

  :global(html[data-theme="light"]) .portal-card {
    background: rgba(255, 250, 246, 0.95);
    border-color: var(--card-border);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.35), 0 0 40px rgba(250, 90, 54, 0.18);
  }
  :global(html[data-theme="light"]) .portal-card-title { color: var(--text-main); }
  :global(html[data-theme="light"]) .portal-card-muted { color: var(--text-muted); }
</style>
