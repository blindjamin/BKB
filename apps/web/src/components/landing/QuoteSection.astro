---
import { quoteOptions } from '../../data/landing';
import { SITE, QUOTE_ENDPOINT } from '../../config/site';
import { getPath } from '../../utils/paths';
import SectionHeading from '../ui/SectionHeading.astro';

const isEndpointAvailable = Boolean(QUOTE_ENDPOINT);
const mapQuery = encodeURIComponent(`${SITE.officeAddress}, Chile`);
const mapSrc = `https://www.google.com/maps?q=${mapQuery}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
---

<section id="cotizar" class="py-24 border-t border-card-border scroll-mt-[80px]">
  <div class="max-w-[var(--bkb-container)] mx-auto px-5 sm:px-10">

    <div class="reveal">
      <SectionHeading eyebrow="CONTACTO Y UBICACIÓN" title="Hablemos de tu proyecto." />
    </div>

    <!-- Formulario a la izquierda; datos de contacto y mapa a la derecha (apilados en celular) -->
    <div class="grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] gap-8 items-stretch">

      <!-- Formulario -->
      <div class="reveal bg-card border border-card-border rounded-[18px] p-8 sm:p-10 shadow-lg">
        <div class="mb-8">
          <h2 class="font-display font-bold text-[28px] text-main mb-2 m-0">Cotizar Obra o Servicio</h2>
          <p class="text-[14.5px] text-muted m-0">Completa el formulario y nuestro equipo de ingeniería te contactará a la brevedad.</p>
        </div>

        <form action={QUOTE_ENDPOINT} method="POST" class="flex flex-col gap-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="flex flex-col gap-1.5">
              <label for="name" class="text-[13px] font-semibold text-main">Nombre completo</label>
              <input type="text" id="name" name="name" required autocomplete="name" placeholder="Ej. Juan Pérez" class="h-[46px] px-4 rounded-input bg-input border border-input-border text-main text-[14.5px] focus:outline-none focus:border-salmon-500 focus:ring-1 focus:ring-salmon-500 transition-colors" />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="organization" class="text-[13px] font-semibold text-main">Empresa</label>
              <input type="text" id="organization" name="organization" required autocomplete="organization" placeholder="Razón social" class="h-[46px] px-4 rounded-input bg-input border border-input-border text-main text-[14.5px] focus:outline-none focus:border-salmon-500 focus:ring-1 focus:ring-salmon-500 transition-colors" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="flex flex-col gap-1.5">
              <label for="email" class="text-[13px] font-semibold text-main">Correo electrónico</label>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder="correo@empresa.cl" class="h-[46px] px-4 rounded-input bg-input border border-input-border text-main text-[14.5px] focus:outline-none focus:border-salmon-500 focus:ring-1 focus:ring-salmon-500 transition-colors" />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="tel" class="text-[13px] font-semibold text-main">Teléfono</label>
              <input type="tel" id="tel" name="tel" required autocomplete="tel" placeholder="+56 9 0000 0000" class="h-[46px] px-4 rounded-input bg-input border border-input-border text-main text-[14.5px] focus:outline-none focus:border-salmon-500 focus:ring-1 focus:ring-salmon-500 transition-colors" />
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="service" class="text-[13px] font-semibold text-main">Servicio requerido</label>
            <select id="service" name="service" required class="h-[46px] px-4 rounded-input bg-input border border-input-border text-main text-[14.5px] focus:outline-none focus:border-salmon-500 focus:ring-1 focus:ring-salmon-500 transition-colors appearance-none cursor-pointer">
              <option value="" disabled selected>Selecciona una opción...</option>
              {quoteOptions.map(opt => (
                <option value={opt}>{opt}</option>
              ))}
            </select>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="message" class="text-[13px] font-semibold text-main">Detalles del proyecto</label>
            <textarea id="message" name="message" required rows="4" placeholder="Describe brevemente los requerimientos, ubicación y plazos estimados..." class="p-4 rounded-input bg-input border border-input-border text-main text-[14.5px] focus:outline-none focus:border-salmon-500 focus:ring-1 focus:ring-salmon-500 transition-colors resize-y"></textarea>
          </div>

          <!-- Anti-bot honeypot -->
          <div class="hidden" aria-hidden="true">
            <label for="bot-field">No llenar si eres humano</label>
            <input type="text" id="bot-field" name="bot-field" tabindex="-1" />
          </div>

          <div class="flex items-start gap-3 mt-2">
            <input type="checkbox" id="consent" name="consent" required class="mt-1 w-4 h-4 rounded-sm border-input-border bg-input text-salmon-500 focus:ring-salmon-500" />
            <label for="consent" class="text-[13px] text-muted leading-snug cursor-pointer">
              He leído y acepto la <a href={getPath('/privacidad')} class="text-salmon-500 hover:underline focus-bkb rounded-sm">Política de Privacidad</a> respecto al tratamiento de mis datos personales (Ley 21.719).
            </label>
          </div>

          <button 
            type="submit" 
            class="mt-4 flex items-center justify-center h-[52px] rounded-pill bg-salmon-500 text-white font-semibold text-[15.5px] transition-all hover:bg-salmon-700 hover:-translate-y-0.5 focus:outline-none focus-visible:outline-[3px] focus-visible:outline-salmon-500 focus-visible:outline-offset-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:translate-y-0"
            disabled={!isEndpointAvailable}
          >
            Enviar Solicitud &rarr;
          </button>
          
          {!isEndpointAvailable && (
            <div class="mt-2 text-[12.5px] text-warning bg-warning/10 border border-warning/30 p-3 rounded-md text-center font-medium">
              Formulario en habilitación. Escríbenos a <a href={`mailto:${SITE.email}`} class="underline hover:text-salmon-500">{SITE.email}</a> o llama al <a href={SITE.phoneHref} class="underline hover:text-salmon-500">{SITE.phoneDisplay}</a>
            </div>
          )}
        </form>
      </div>

      <!-- Datos de contacto + mapa -->
      <div class="reveal flex flex-col gap-6">
        <div class="bg-card border border-card-border rounded-[18px] p-8 flex flex-col gap-5 shadow-lg">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-xl bg-salmon-500/15 border border-salmon-500/35 flex items-center justify-center text-salmon-500 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <div class="font-display font-bold text-[17px] text-main">Oficina Central</div>
              <div class="text-[13.5px] text-muted">{SITE.officeAddress}</div>
            </div>
          </div>

          <p class="text-[14.5px] leading-[1.6] text-muted m-0">
            Atendemos proyectos en {SITE.coverage}. Coordina una visita técnica o retira/entrega documentación en nuestra oficina.
          </p>

          <div class="flex flex-col gap-3 pt-4 border-t border-card-border">
            <a href={SITE.phoneHref} class="flex items-center gap-2 text-[14px] font-semibold text-main hover:text-salmon-500 transition-colors focus-bkb rounded-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-salmon-500" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
              {SITE.phoneDisplay}
            </a>
            <a href={`mailto:${SITE.email}`} class="flex items-center gap-2 text-[14px] font-semibold text-main hover:text-salmon-500 transition-colors focus-bkb rounded-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-salmon-500" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              {SITE.email}
            </a>
          </div>
        </div>

        <!-- Mapa bajo demanda: Google Maps (y sus cookies) solo se carga cuando la persona hace clic -->
        <div class="map-box relative flex-1 bg-card rounded-[18px] overflow-hidden border border-card-border shadow-lg min-h-[300px]" data-map-box data-map-src={mapSrc}>
          <div class="map-placeholder absolute inset-0 flex flex-col items-center justify-center gap-4 p-6 text-center" data-map-placeholder>
            <div class="w-14 h-14 rounded-full bg-salmon-500/15 border border-salmon-500/35 flex items-center justify-center text-salmon-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/>
              </svg>
            </div>
            <div>
              <div class="font-display font-bold text-[16px] text-main">{SITE.officeAddress}</div>            </div>
            <div class="flex flex-wrap items-center justify-center gap-3">
              <button type="button" data-map-load class="inline-flex items-center gap-2 px-5 py-2.5 rounded-pill bg-salmon-500 text-white text-[14px] font-semibold transition-colors hover:bg-salmon-700 focus-bkb cursor-pointer">
                Ver mapa
              </button>
              <a href={mapLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[13.5px] font-semibold text-main hover:text-salmon-500 transition-colors focus-bkb rounded-sm">
                Abrir en Google Maps
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Carga el mapa de Google solo al hacer clic (privacidad: sin cookies de Google hasta que la persona lo pide)
  document.querySelectorAll<HTMLElement>('[data-map-box]').forEach((box) => {
    const btn = box.querySelector<HTMLButtonElement>('[data-map-load]');
    btn?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = box.dataset.mapSrc || '';
      iframe.title = 'Mapa de ubicación de la oficina de BKB';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.style.cssText = 'border:0; width:100%; height:100%; min-height:300px; display:block;';
      box.querySelector('[data-map-placeholder]')?.remove();
      box.appendChild(iframe);
      iframe.focus();
    });
  });
</script>
