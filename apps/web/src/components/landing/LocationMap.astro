---
import SectionHeading from '../ui/SectionHeading.astro';
import { SITE } from '../../config/site';

const mapQuery = encodeURIComponent(`${SITE.officeAddress}, Chile`);
const mapSrc = `https://www.google.com/maps?q=${mapQuery}&output=embed`;
---

<section class="py-24 max-w-[var(--bkb-container)] mx-auto px-5 sm:px-10">
  <div class="reveal">
    <SectionHeading eyebrow="UBICACIÓN" title="Dónde estamos." />
  </div>

  <div class="reveal grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-8 items-stretch">
    <div class="bg-card border border-card-border rounded-[20px] p-8 flex flex-col gap-5 justify-center">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-xl bg-salmon-500/15 border border-salmon-500/35 flex items-center justify-center text-salmon-500 shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <div>
          <div class="font-display font-bold text-[17px] text-main">Oficina Central</div>
          <div class="text-[13.5px] text-muted">{SITE.officeAddress}</div>
        </div>
      </div>

      <p class="text-[14.5px] leading-[1.6] text-muted m-0">
        Atendemos proyectos en {SITE.coverage}. Coordina una visita técnica o retira/entrega documentación en nuestra oficina.
      </p>

      <div class="flex flex-col gap-3 pt-2 border-t border-card-border">
        <a href={SITE.phoneHref} class="flex items-center gap-2 text-[13.5px] font-semibold text-main hover:text-salmon-500 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-salmon-500" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
          {SITE.phoneDisplay}
        </a>
        <a href={`mailto:${SITE.email}`} class="flex items-center gap-2 text-[13.5px] font-semibold text-main hover:text-salmon-500 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-salmon-500" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          {SITE.email}
        </a>
      </div>
    </div>

    <div class="rounded-[20px] overflow-hidden border border-card-border shadow-xl min-h-[320px]">
      <iframe
        src={mapSrc}
        width="100%"
        height="100%"
        style="border:0; min-height: 320px; display: block;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title={`Mapa de ubicación — ${SITE.office}`}
      ></iframe>
    </div>
  </div>
</section>
