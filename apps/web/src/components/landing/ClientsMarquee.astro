---
import { Image } from 'astro:assets';
import { brands } from '../../data/landing';
import Eyebrow from '../ui/Eyebrow.astro';
---

<section class="py-12 border-y border-card-border overflow-hidden bg-page">
  <div class="text-center mb-8 reveal">
    <Eyebrow text="CONFÍAN EN BKB" />
  </div>

  <div class="marquee-container reveal group">
    <div class="marquee-track group-hover:pause group-focus-within:pause">
      
      <!-- Primera vuelta -->
      <ul class="marquee-list m-0 p-0 list-none flex items-center gap-6">
        {brands.map(brand => (
          <li class="shrink-0 w-[150px] h-[84px] bg-white rounded-[10px] flex items-center justify-center p-3">
            <Image src={brand.img} alt={brand.alt} class="w-full h-full object-contain mix-blend-multiply" />
          </li>
        ))}
      </ul>

      <!-- Segunda vuelta (oculta para lectores de pantalla) -->
      <ul class="marquee-list m-0 p-0 list-none flex items-center gap-6" aria-hidden="true">
        {brands.map(brand => (
          <li class="shrink-0 w-[150px] h-[84px] bg-white rounded-[10px] flex items-center justify-center p-3">
            <Image src={brand.img} alt="" class="w-full h-full object-contain mix-blend-multiply" />
          </li>
        ))}
      </ul>
      
    </div>
  </div>
</section>

<style>
  .marquee-container {
    width: 100%;
    overflow: hidden;
  }
  
  .marquee-track {
    display: flex;
    gap: 1.5rem; /* gap-6 (24px) */
    width: max-content;
    animation: marqueeScroll 32s linear infinite;
  }

  .pause {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      max-width: var(--bkb-container);
      margin: 0 auto;
    }
    .marquee-track > ul:last-child {
      display: none;
    }
    .marquee-list {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
