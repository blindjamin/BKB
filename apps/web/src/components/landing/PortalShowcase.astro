---
import SectionHeading from '../ui/SectionHeading.astro';
import { PORTAL_URLS } from '../../config/site';

const features = [
  "Descarga de certificados SEC TE1 y anexos",
  "Dossier de calidad y planos As-Built en PDF/DWG",
  "Informes termográficos e historial de mantención"
];
---

<section id="portal" class="py-24 max-w-[var(--bkb-container)] mx-auto px-5 sm:px-10 scroll-mt-[80px]">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
    
    <div class="reveal flex flex-col items-start gap-8">
      <SectionHeading eyebrow="PORTAL CLIENTES" title="Toda tu documentación técnica, siempre a mano." />
      
      <ul class="flex flex-col gap-4 m-0 p-0 list-none">
        {features.map(f => (
          <li class="flex items-center gap-3 text-[15px] font-medium text-muted">
            <span class="w-2 h-2 rounded-full bg-salmon-500 shrink-0" aria-hidden="true"></span>
            <span>{f}</span>
          </li>
        ))}
      </ul>
      
      <a href={PORTAL_URLS.cliente} class="mt-4 inline-flex items-center justify-center px-6 py-3 rounded-pill bg-card border border-card-border text-main text-[14.5px] font-semibold hover:border-salmon-500 hover:text-salmon-500 transition-colors focus-bkb">
        Ingresar al Portal &rarr;
      </a>
    </div>

    <div class="reveal relative w-full perspective-1000">
      <span class="sr-only">Ejemplo ilustrativo del portal documental</span>
      <div class="w-full bg-card rounded-[14px] border border-card-border shadow-2xl overflow-hidden flex flex-col transform rotate-y-[-2deg] rotate-x-[2deg]" aria-hidden="true">

        <!-- Header Maqueta -->
        <div class="h-12 bg-page flex items-center px-4 gap-4 border-b border-card-border">
          <div class="flex gap-2">
            <span class="w-3 h-3 rounded-full bg-danger"></span>
            <span class="w-3 h-3 rounded-full bg-warning"></span>
            <span class="w-3 h-3 rounded-full bg-success"></span>
          </div>
          <div class="flex-1 max-w-[60%] mx-auto bg-card rounded-md h-7 flex items-center justify-center border border-card-border">
            <span class="font-mono text-[11px] text-muted truncate px-2">portal.bkb.cl/obras/sopraval-tdf</span>
          </div>
        </div>

        <!-- Cuerpo Maqueta -->
        <div class="p-6 flex flex-col gap-4 bg-card">
          <div class="flex items-center justify-between p-3 rounded-md bg-success/10 border border-success/30">
            <div class="flex items-center gap-3">
              <span class="text-success text-[18px]">📄</span>
              <span class="font-display font-bold text-[13px] text-success">Certificado SEC TE1 Vigente</span>
            </div>
            <span class="font-mono text-[10px] text-success px-2 py-0.5 rounded-full bg-success/20">Aprobado</span>
          </div>

          <div class="flex items-center justify-between p-3 rounded-md bg-page border border-card-border">
            <div class="flex items-center gap-3">
              <span class="text-[18px] opacity-70">📐</span>
              <span class="font-sans font-medium text-[13px] text-main">Plano Unilineal As-Built</span>
            </div>
            <span class="font-mono text-[10px] text-muted">2.4 MB · DWG</span>
          </div>

          <div class="flex items-center justify-between p-3 rounded-md bg-page border border-card-border">
            <div class="flex items-center gap-3">
              <span class="text-[18px] opacity-70">🌡</span>
              <span class="font-sans font-medium text-[13px] text-main">Informe Termografía Infrarroja</span>
            </div>
            <span class="font-mono text-[10px] text-muted">1.1 MB · PDF</span>
          </div>

          <div class="flex items-center justify-between p-3 rounded-md bg-page border border-card-border opacity-60">
            <div class="flex items-center gap-3">
              <svg class="text-muted" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span class="font-sans font-medium text-[13px] text-muted">Dossier Calidad (En proceso)</span>
            </div>
            <span class="font-mono text-[10px] text-subtle">Restringido</span>
          </div>
        </div>

      </div>
    </div>
    
  </div>
</section>
