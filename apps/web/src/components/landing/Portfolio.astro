---
import { Image } from 'astro:assets';
import { portafolio } from '../../data/landing';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="obras" class="py-24 border-y border-card-border scroll-mt-[80px]">
  <div class="max-w-[var(--bkb-container)] mx-auto px-5 sm:px-10">
    <div class="reveal">
      <SectionHeading eyebrow="PORTAFOLIO" title="Proyectos recientes." />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {portafolio.map((p, index) => (
        <div 
          class="reveal flex flex-col gap-4 group cursor-pointer"
          style={`transition-delay: ${index * 100}ms;`}
        >
          <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden bg-card border border-card-border">
            <Image 
              src={p.img} 
              alt={p.title} 
              class="w-full h-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.06]" 
              loading="lazy" 
              sizes="(max-width: 768px) 100vw, (max-width: 1200px) 33vw, 400px"
            />
            
            <div class="absolute top-3 left-3 z-10 flex items-center px-2 py-1 bg-success/90 backdrop-blur-sm border border-success text-white rounded-pill gap-1.5 shadow-sm">
              <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
              <span class="font-mono font-bold text-[9.5px] uppercase tracking-wider">SEC TE1 VIGENTE</span>
            </div>
          </div>
          
          <div class="flex flex-col gap-1 px-1">
            <h3 class="font-display font-bold text-[15.5px] leading-[1.3] text-main m-0 group-hover:text-salmon-500 transition-colors">{p.title}</h3>
            <span class="font-mono text-[12px] text-muted">{p.spec}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
