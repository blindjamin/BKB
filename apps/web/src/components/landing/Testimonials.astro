---
// TODO: PLACEHOLDER FICTICIO — el contenido de `testimonials` (data/landing.ts) es ficticio.
// Reemplazar por reseñas reales antes de publicar a producción.
import { testimonials } from '../../data/landing';
import SectionHeading from '../ui/SectionHeading.astro';

const initials = (name: string) => name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
---

<section class="py-24 border-y border-card-border">
  <div class="max-w-[var(--bkb-container)] mx-auto px-5 sm:px-10">
    <div class="reveal">
      <SectionHeading eyebrow="TESTIMONIOS" title="Lo que dicen quienes trabajan con nosotros." />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {testimonials.map((t, index) => (
        <div
          class="reveal bg-card border border-card-border rounded-[16px] p-[28px] flex flex-col gap-5 h-full"
          style={`transition-delay: ${index * 100}ms;`}
        >
          <div class="flex gap-1 text-salmon-500" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14l-5-4.87 6.91-1.01z"/>
              </svg>
            ))}
          </div>

          <p class="text-[14.5px] leading-[1.65] text-main m-0 flex-1">&ldquo;{t.quote}&rdquo;</p>

          <div class="flex items-center gap-3 pt-2 border-t border-card-border">
            <div class="w-10 h-10 shrink-0 rounded-full bg-salmon-500/15 text-salmon-500 font-display font-bold text-[13px] flex items-center justify-center">
              {initials(t.name)}
            </div>
            <div class="flex flex-col">
              <span class="text-[13.5px] font-semibold text-main">{t.name}</span>
              <span class="text-[12px] text-muted">{t.role}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
