---
import { mercados } from '../../data/landing';
import SectionHeading from '../ui/SectionHeading.astro';

const icons = [
  // Agroindustria & Alimentos (hoja)
  '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>',
  // Recursos Hídricos & Sanitaria (gota)
  '<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>',
  // Energía & Generación (rayo)
  '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
];
---

<section id="mercados" class="py-24 max-w-[var(--bkb-container)] mx-auto px-5 sm:px-10 scroll-mt-[80px]">
  <div class="reveal">
    <SectionHeading eyebrow="MERCADOS" title="Experiencia por industria." />
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {mercados.map((m, index) => (
      <div 
        class="reveal bg-card border border-card-border rounded-[16px] p-[28px] transition-transform duration-300 hover:-translate-y-1 flex flex-col h-full"
        style={`transition-delay: ${index * 100}ms;`}
      >
        <div class="w-12 h-12 rounded-xl bg-salmon-300/15 mb-5 flex items-center justify-center text-salmon-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[index]} />
        </div>

        <h3 class="font-display font-bold text-[20px] leading-[1.25] text-main mb-3">{m.title}</h3>
        <p class="text-[14.5px] leading-[1.55] text-muted m-0 mb-6 flex-1">{m.desc}</p>
        
        <div class="pt-5 border-t border-card-border mt-auto">
          <span class="font-mono text-[12px] font-medium text-subtle uppercase tracking-[0.02em]">
            <span class="text-main font-semibold mr-1">CLIENTES:</span> {m.clients}
          </span>
        </div>
      </div>
    ))}
  </div>
</section>
