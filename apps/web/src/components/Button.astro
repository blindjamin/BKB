---
import { getPath } from '../utils/paths';

interface Props {
  variant?: 'primary' | 'secondary' | 'tertiary';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  className?: string;
  [key: string]: any;
}

const { 
  variant = 'primary', 
  href, 
  type = 'button', 
  className = '',
  ...rest 
} = Astro.props;

const variantClass = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  tertiary: 'btn-tertiary',
}[variant];

const resolvedHref = href
  ? (href.startsWith('http') || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')
      ? href
      : getPath(href))
  : undefined;
---

{resolvedHref ? (
  <a href={resolvedHref} class={`btn ${variantClass} focus-bkb ${className}`} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class={`btn ${variantClass} focus-bkb ${className}`} {...rest}>
    <slot />
  </button>
)}
