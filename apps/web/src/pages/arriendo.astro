---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import PillButton from '../components/ui/PillButton.astro';
import { gruposArriendo, type EquipoArriendo } from '../data/arriendo';
import { SITE } from '../config/site';
import { getPath } from '../utils/paths';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Foto de cada equipo: src/assets/arriendo/<id>.jpg (fondo blanco del fabricante)
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/arriendo/*.jpg', { eager: true });
const foto = (id: string) => fotos[`../assets/arriendo/${id}.jpg`]?.default;

// Mismo armado wa.me que WhatsAppButton.astro
const digits = SITE.phoneHref.replace(/\D/g, '');
const waGeneral = `https://wa.me/${digits}?text=${encodeURIComponent('Hola, quisiera cotizar el arriendo de equipos con técnico BKB.')}`;
const etiqueta = (e: EquipoArriendo) => (e.modelo ? `${e.nombre} (${e.modelo})` : e.nombre);
---

<Layout
  title="Arriendo de Equipos"
  description="Arriendo de instrumentos Fluke y generadores, siempre con un técnico de BKB que opera el equipo. Elige los equipos y cotiza por WhatsApp."
  headerMode="solid"
>
  <!-- Encabezado -->
  <div class="bg-page py-16 border-b border-card-border">
    <div class="max-w-[var(--bkb-container)] mx-auto px-5 sm:px-10 flex flex-col items-start gap-3">
      <Eyebrow text="Arriendo de equipos" />
      <h1 class="font-display font-bold text-[length:var(--bkb-text-h2)] leading-[1.1] text-main m-0">
        Instrumentos y generadores,<br />siempre con técnico BKB
      </h1>
      <p class="text-[16px] leading-[1.6] text-muted max-w-[60ch] m-0">
        Todo arriendo incluye un técnico de BKB que opera el equipo en tu planta u obra. No arrendamos equipos solos.
        Elige uno o varios y pide la cotización de todos en un solo mensaje de WhatsApp.
      </p>
    </div>
  </div>

  <!-- Equipos -->
  <div class="max-w-[var(--bkb-container)] mx-auto w-full px-5 sm:px-10 py-16 flex flex-col gap-12">
    {gruposArriendo.map((g, i) => (
      <section aria-labelledby={`grupo-${i}`} class="flex flex-col gap-4">
        <h2 id={`grupo-${i}`} class="font-display font-bold text-[22px] text-main m-0">{g.titulo}</h2>
        <ul class="list-none m-0 p-0 grid grid-cols-1 md:grid-cols-2 gap-3">
          {g.equipos.map((e) => (
            <li>
              <article
                class="equipo group h-full flex flex-col gap-4 p-5 bg-card border border-card-border rounded-card transition-colors [&.is-selected]:border-salmon-500"
                data-id={e.id}
                data-label={etiqueta(e)}
              >
                {foto(e.id) && (
                  <div class="rounded-lg bg-white h-[180px] flex items-center justify-center overflow-hidden">
                    <Image src={foto(e.id)!} alt="" widths={[320, 640]} sizes="(min-width: 768px) 320px, 90vw" class="max-h-[160px] w-auto object-contain" />
                  </div>
                )}
                <div>
                  <h3 class="font-display font-bold text-[16px] leading-[1.3] text-main m-0">
                    <span class="hidden group-[.is-selected]:inline text-[var(--accent-text)]"><span aria-hidden="true">✓ </span><span class="sr-only">Agregado: </span></span>{e.nombre}
                  </h3>
                  {e.modelo && <p class="font-mono text-[12px] text-muted mt-1 mb-0">{e.modelo}</p>}
                </div>
                <p class="text-[14.5px] leading-[1.55] text-muted m-0">{e.uso}</p>
                <!-- mt-auto: el botón queda al fondo y alineado entre tarjetas de la misma fila -->
                <div class="mt-auto">
                  <button
                    type="button"
                    data-agregar
                    aria-pressed="false"
                    class="js-only inline-flex items-center justify-center min-h-[44px] px-5 rounded-pill border border-salmon-700 bg-salmon-700 text-white text-[14px] font-semibold cursor-pointer transition-colors hover:bg-salmon-800 aria-pressed:bg-transparent aria-pressed:border-salmon-500 aria-pressed:text-[var(--accent-text)] aria-pressed:hover:bg-transparent focus-bkb"
                  ><span class="sr-only">Agregar a la cotización</span><span data-texto aria-hidden="true">Agregar a la cotización</span></button>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <!-- Cierre -->
  <div class="border-t border-card-border">
    <div class="max-w-[var(--bkb-container)] mx-auto w-full px-5 sm:px-10 py-16 flex flex-col items-start gap-4">
      <h2 class="font-display font-bold text-[length:var(--bkb-text-h2)] leading-[1.1] text-main m-0">¿Necesitas otro equipo o servicio?</h2>
      <p class="text-[16px] leading-[1.6] text-muted max-w-[60ch] m-0">
        Escríbenos por WhatsApp y lo conversamos. También puedes pedir una cotización de obra desde el formulario de contacto.
      </p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <PillButton href={waGeneral} target="_blank" rel="noopener noreferrer">Escribir por WhatsApp</PillButton>
        <a href={`${getPath('/')}#cotizar`} class="text-[15px] font-semibold text-[var(--accent-text)] underline underline-offset-4 focus-bkb rounded-sm">Ir al formulario de cotización</a>
      </div>
    </div>
  </div>

  <!-- Barra de cotización (la maneja el script; sin JS nunca aparece) -->
  <p id="cotizacion-estado" class="sr-only" aria-live="polite"></p>
  <div id="cotizacion-barra" class="cotizacion-barra fixed inset-x-0 bottom-0 z-50 bg-card border-t border-card-border shadow-2xl" hidden>
    <div class="max-w-[var(--bkb-container)] mx-auto px-5 sm:px-10 pt-3 flex flex-col sm:flex-row sm:items-center gap-3">
      <div class="flex-1 min-w-0">
        <p id="cotizacion-contador" class="m-0 font-semibold text-[14.5px] text-main"></p>
        <ul id="cotizacion-lista" class="list-none m-0 p-0 mt-2 flex flex-wrap gap-2 max-h-[30vh] overflow-y-auto"></ul>
      </div>
      <PillButton href={waGeneral} id="cotizacion-wa" target="_blank" rel="noopener noreferrer" class="shrink-0">Cotizar por WhatsApp</PillButton>
    </div>
  </div>
</Layout>

<style>
  /* Sin JavaScript no se muestran los botones de agregar */
  :global(html:not(.js)) .js-only { display: none; }

  .cotizacion-barra { padding-bottom: max(12px, env(safe-area-inset-bottom, 0px)); }

  /* Con la barra visible se ocultan el WhatsApp flotante y el aviso de emergencia, para que no se tapen */
  :global(html.has-cotizacion .whatsapp-fab),
  :global(html.has-cotizacion .emergency-notice) { display: none; }
</style>

<script>
  // Selección de equipos para cotizar. Vive en memoria: al recargar se pierde (spec §6).
  const INTRO = 'Hola, quisiera cotizar el arriendo con técnico BKB de:';
  const CHIP = 'inline-flex items-center gap-1.5 min-h-[32px] px-3 rounded-pill border border-card-border bg-page text-main text-[13px] cursor-pointer hover:border-salmon-500 focus-bkb';

  function mensajeWhatsApp(labels: string[]): string {
    return [INTRO, ...labels.map((l) => `- ${l}`)].join('\n');
  }

  function initArriendo() {
    const barra = document.getElementById('cotizacion-barra');
    const contador = document.getElementById('cotizacion-contador');
    const estado = document.getElementById('cotizacion-estado');
    const lista = document.getElementById('cotizacion-lista');
    const wa = document.getElementById('cotizacion-wa') as HTMLAnchorElement | null;
    if (!barra || !contador || !estado || !lista || !wa) return;

    const tarjetas = Array.from(document.querySelectorAll<HTMLElement>('.equipo'));
    const waBase = wa.href.split('?')[0];
    const elegidos = new Set<string>();

    const ajustarEspacio = () => {
      // Deja espacio bajo el contenido para que la barra no tape el último equipo
      document.body.style.paddingBottom = barra.hidden ? '' : `${barra.offsetHeight}px`;
      // Evita que la barra fija tape el elemento con foco al navegar con teclado
      document.documentElement.style.scrollPaddingBottom = barra.hidden ? '' : `${barra.offsetHeight + 8}px`;
    };

    const render = () => {
      // Orden de la página, no el orden en que se agregaron
      const sel = tarjetas.filter((t) => elegidos.has(t.dataset.id!));
      const n = sel.length;

      tarjetas.forEach((t) => {
        const on = elegidos.has(t.dataset.id!);
        t.classList.toggle('is-selected', on);
        const btn = t.querySelector<HTMLButtonElement>('[data-agregar]');
        if (!btn) return;
        btn.setAttribute('aria-pressed', String(on));
        // El nombre accesible (span sr-only) es fijo; solo cambia el texto visible
        btn.querySelector('[data-texto]')!.textContent = on ? '✓ Agregado · Quitar' : 'Agregar a la cotización';
      });

      lista.replaceChildren(...sel.map((t) => {
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.type = 'button';
        b.className = CHIP;
        b.dataset.quitar = t.dataset.id;
        b.setAttribute('aria-label', `Quitar ${t.dataset.label}`);
        b.textContent = `${t.dataset.label} ×`;
        li.append(b);
        return li;
      }));

      const texto = n === 0 ? 'Ningún equipo seleccionado' : n === 1 ? '1 equipo seleccionado' : `${n} equipos seleccionados`;
      contador.textContent = texto;
      estado.textContent = texto;
      wa.href = `${waBase}?text=${encodeURIComponent(mensajeWhatsApp(sel.map((t) => t.dataset.label!)))}`;

      barra.hidden = n === 0;
      document.documentElement.classList.toggle('has-cotizacion', n > 0);
      ajustarEspacio();
    };

    document.addEventListener('click', (ev) => {
      const el = ev.target as HTMLElement;

      const agregar = el.closest<HTMLButtonElement>('[data-agregar]');
      if (agregar) {
        const id = agregar.closest<HTMLElement>('.equipo')?.dataset.id;
        if (!id) return;
        if (elegidos.has(id)) elegidos.delete(id);
        else elegidos.add(id);
        render();
        return;
      }

      const quitar = el.closest<HTMLButtonElement>('[data-quitar]');
      if (quitar) {
        const id = quitar.dataset.quitar!;
        const pos = Array.from(lista.querySelectorAll('[data-quitar]')).indexOf(quitar);
        elegidos.delete(id);
        render();
        // El chip desaparece: el foco pasa al chip que ocupa su posición o, si no quedan, al botón de la tarjeta
        const chips = lista.querySelectorAll<HTMLElement>('button');
        (chips[Math.min(pos, chips.length - 1)] ?? document.querySelector<HTMLElement>(`.equipo[data-id="${id}"] [data-agregar]`))?.focus();
      }
    });

    window.addEventListener('resize', ajustarEspacio);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArriendo);
  } else {
    initArriendo();
  }
</script>
