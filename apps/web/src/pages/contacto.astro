---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { getPath } from '../utils/paths';
---

<Layout 
  title="Contacto & Cotización de Obras"
  description="Contáctenos para cotizar proyectos de ingeniería eléctrica, tableros TDF/TDA, automatizaciones y mantenciones industriales."
>
  <div class="bg-[#FBF8F5] py-16 border-b border-[#E6DDD5]">
    <div class="container-bkb">
      <span class="text-xs font-mono font-bold tracking-wider text-[#B4470F] uppercase">Atención Comercial y Faenas</span>
      <h1 class="display-lg text-[#1A1513] mt-2 mb-4">Cotizar Proyecto o Visita Técnica</h1>
      <p class="body-base text-[#7D6F64] max-w-3xl">
        Complete el siguiente formulario y un ingeniero de proyectos se comunicará en un plazo máximo de 24 horas hábiles para coordinar el levantamiento técnico.
      </p>
    </div>
  </div>

  <div class="container-bkb py-16">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- FORMULARIO DE CONTACTO -->
      <div class="lg:col-span-2">
        <form class="card-bkb space-y-6" id="quote-form">
          <!-- Campo trampa anti-bots (Honeypot) -->
          <div class="hidden" aria-hidden="true">
            <label for="website-check">No complete este campo si es humano:</label>
            <input type="text" id="website-check" name="website_check" tabindex="-1" autocomplete="off" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="nombre" class="block text-sm font-semibold text-[#1A1513] mb-2">Nombre completo *</label>
              <input 
                type="text" 
                id="nombre" 
                name="nombre" 
                required 
                class="w-full px-4 py-3 rounded-lg border border-[#E6DDD5] bg-white text-[#1A1513] focus-bkb text-sm"
                placeholder="Ej. Carlos Mendoza"
              />
            </div>

            <div>
              <label for="empresa" class="block text-sm font-semibold text-[#1A1513] mb-2">Empresa / Razón Social *</label>
              <input 
                type="text" 
                id="empresa" 
                name="empresa" 
                required 
                class="w-full px-4 py-3 rounded-lg border border-[#E6DDD5] bg-white text-[#1A1513] focus-bkb text-sm"
                placeholder="Ej. Industrias del Norte SpA"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="rut" class="block text-sm font-semibold text-[#1A1513] mb-2">RUT de Empresa (opcional)</label>
              <input 
                type="text" 
                id="rut" 
                name="rut" 
                class="w-full px-4 py-3 rounded-lg border border-[#E6DDD5] bg-white text-[#1A1513] font-mono focus-bkb text-sm"
                placeholder="76.123.456-7"
              />
            </div>

            <div>
              <label for="telefono" class="block text-sm font-semibold text-[#1A1513] mb-2">Teléfono de contacto *</label>
              <input 
                type="tel" 
                id="telefono" 
                name="telefono" 
                required 
                class="w-full px-4 py-3 rounded-lg border border-[#E6DDD5] bg-white text-[#1A1513] font-mono focus-bkb text-sm"
                placeholder="+56 9 1234 5678"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="email" class="block text-sm font-semibold text-[#1A1513] mb-2">Correo electrónico corporativo *</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                class="w-full px-4 py-3 rounded-lg border border-[#E6DDD5] bg-white text-[#1A1513] focus-bkb text-sm"
                placeholder="carlos@empresa.cl"
              />
            </div>

            <div>
              <label for="servicio" class="block text-sm font-semibold text-[#1A1513] mb-2">Servicio requerido *</label>
              <select 
                id="servicio" 
                name="servicio" 
                required 
                class="w-full px-4 py-3 rounded-lg border border-[#E6DDD5] bg-white text-[#1A1513] focus-bkb text-sm"
              >
                <option value="">Seleccione una especialidad...</option>
                <option value="ingenieria">Ingeniería Eléctrica y Tramitación SEC TE1</option>
                <option value="tableros">Fabricación y Montaje de Tableros TDF / TDA</option>
                <option value="automatizacion">Automatización, PLC y Control SCADA</option>
                <option value="obras-civiles">Obras Civiles Eléctricas & Canalizaciones</option>
                <option value="mantencion">Mantención Preventiva / Termografía</option>
                <option value="otro">Otro requerimiento especial</option>
              </select>
            </div>
          </div>

          <div>
            <label for="mensaje" class="block text-sm font-semibold text-[#1A1513] mb-2">Descripción del proyecto o requerimiento *</label>
            <textarea 
              id="mensaje" 
              name="mensaje" 
              rows="5" 
              required 
              class="w-full px-4 py-3 rounded-lg border border-[#E6DDD5] bg-white text-[#1A1513] focus-bkb text-sm"
              placeholder="Indique ubicación de la faena, potencia estimada o especificaciones relevantes..."
            ></textarea>
          </div>

          <div class="flex items-start gap-3 pt-2">
            <input 
              type="checkbox" 
              id="privacidad" 
              name="privacidad" 
              required 
              class="mt-1 rounded border-[#E6DDD5] text-[#B4470F] focus:ring-[#B4470F]"
            />
            <label for="privacidad" class="text-xs text-[#7D6F64] leading-relaxed">
              Acepto la <a href={getPath('/privacidad')} class="text-[#B4470F] underline">política de privacidad</a> para el tratamiento de mis datos de contacto comercial conforme a la Ley 21.719.
            </label>
          </div>

          <div class="pt-4">
            <Button type="submit" variant="primary" className="w-full sm:w-auto">
              Enviar Solicitud de Cotización
            </Button>
          </div>
        </form>
      </div>

      <!-- INFORMACIÓN DIRECTA DE CONTACTO -->
      <div class="space-y-6">
        <div class="card-bkb bg-[#FAF6F2]">
          <h3 class="font-display text-lg font-bold text-[#1A1513] mb-4">Canales Directos</h3>
          <ul class="space-y-4 text-sm text-[#7D6F64]">
            <li class="flex items-start gap-3">
              <span class="text-[#B4470F] font-bold">📍</span>
              <div>
                <strong class="text-[#1A1513] block">Oficina y Taller de Montaje:</strong>
                Región de Valparaíso / Región Metropolitana, Chile.
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-[#B4470F] font-bold">✉️</span>
              <div>
                <strong class="text-[#1A1513] block">Cotizaciones y Proyectos:</strong>
                <a href="mailto:cotizaciones@bkb.cl" class="text-[#B4470F] font-mono hover:underline">cotizaciones@bkb.cl</a>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-[#B4470F] font-bold">🚨</span>
              <div>
                <strong class="text-[#1A1513] block">Guardia de Emergencia 24/7:</strong>
                <a href="tel:+56912345678" class="text-[#B4470F] font-mono hover:underline">+56 9 8765 4321</a>
              </div>
            </li>
          </ul>
        </div>

        <div class="card-bkb border-l-4 border-l-[#1E6B47]">
          <h4 class="font-display text-base font-bold text-[#1A1513] mb-1">Clientes Registrados</h4>
          <p class="text-xs text-[#7D6F64] leading-relaxed mb-3">
            Si ya tiene obras en curso y requiere solicitar certificados TE1 o planos, puede hacerlo directamente desde el portal.
          </p>
          <a href="https://portal.bkb.cl" class="text-xs font-bold text-[#1E6B47] hover:underline">
            Ir al Portal Documental BKB →
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
