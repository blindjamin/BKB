---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

const services = [
  {
    id: 'ingenieria',
    code: 'SRV-01',
    title: 'Ingeniería Eléctrica y Regularizaciones SEC',
    summary: 'Desarrollo integral de proyectos de baja y media tensión conforme al Pliego Técnico Normativo RIC.',
    details: [
      'Elaboración de planos unilineales y de distribución bajo norma SEC.',
      'Cálculo y diseño de mallas de tierra con medición de resistividad de terreno.',
      'Estudios de coordinación de protecciones y cortocircuito.',
      'Tramitación y obtención de Declaración TE1 ante la Superintendencia de Electricidad y Combustibles (SEC).'
    ]
  },
  {
    id: 'tableros',
    code: 'SRV-02',
    title: 'Fabricación y Montaje de Tableros TDF / TDA',
    summary: 'Integración en taller propio con equipamiento industrial de primeras marcas mundiales.',
    details: [
      'Tableros de Distribución de Fuerza (TDF) y Alumbrado (TDA).',
      'Centros de Control de Motores (CCM) fijos y extraíbles.',
      'Bancos automáticos de condensadores para corrección de factor de potencia.',
      'Pruebas de aislamiento, continuidad y rigidez dieléctrica previas a entrega.'
    ]
  },
  {
    id: 'automatizacion',
    code: 'SRV-03',
    title: 'Automatización Industrial, Control & PLC',
    summary: 'Control inteligente de procesos productivos, plantas de tratamiento y sistemas de bombeo.',
    details: [
      'Programación de autómatas PLC (Siemens, Schneider, Allen-Bradley).',
      'Desarrollo de interfaces HMI y sistemas SCADA de supervisión remota.',
      'Instrumentación de campo: caudalímetros, sensores de nivel y transmisores de presión.',
      'Integración con protocolos industriales Modbus, Profinet y Ethernet/IP.'
    ]
  },
  {
    id: 'obras-civiles',
    code: 'SRV-04',
    title: 'Obras Civiles Eléctricas & Montaje en Terreno',
    summary: 'Infraestructura física y canalizaciones de servicio pesado para faenas industriales.',
    details: [
      'Instalación de escalerillas portacables galvanizadas y bandejas perforadas.',
      'Bancos de ductos subterráneos de hormigón y cámaras de paso inspeccionables.',
      'Montaje de salas eléctricas modulares y transformadores de distribución.',
      'Tendido de conductores de fuerza y control en faena con protocolos de torque.'
    ]
  },
  {
    id: 'mantencion',
    code: 'SRV-05',
    title: 'Mantención Preventiva, Correctiva & Termografía',
    summary: 'Planes de mantenimiento programado para evitar paradas no planificadas de planta.',
    details: [
      'Inspección termográfica infrarroja certificada de tableros en carga.',
      'Apreté dinanométrico de conexiones y reapriete de barrajes de cobre.',
      'Medición periódica de resistencia de puesta a tierra.',
      'Servicio de guardia de emergencia 24/7 para clientes con contrato vigente.'
    ]
  }
];
---

<Layout 
  title="Servicios Eléctricos Industriales"
  description="Servicios de ingeniería eléctrica, armado de tableros TDF/TDA, automatización con PLC, canalizaciones y mantención técnica en Chile."
>
  <div class="bg-[#FBF8F5] py-16 border-b border-[#E6DDD5]">
    <div class="container-bkb">
      <span class="text-xs font-mono font-bold tracking-wider text-[#B4470F] uppercase">Catálogo de Servicios</span>
      <h1 class="display-lg text-[#1A1513] mt-2 mb-4">Especialidades Técnicas de Ingeniería</h1>
      <p class="body-base text-[#7D6F64] max-w-3xl">
        Ejecutamos cada etapa del ciclo de vida eléctrico: desde la ingeniería conceptual y tramitación TE1, hasta el montaje, automatización y servicio técnico permanente.
      </p>
    </div>
  </div>

  <div class="container-bkb py-16">
    <div class="space-y-12">
      {services.map(s => (
        <section id={s.id} class="card-bkb scroll-mt-28">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
            <span class="text-xs font-mono font-bold text-[#B4470F] bg-[#FFE5D6] px-2.5 py-1 rounded">
              {s.code}
            </span>
            <span class="text-xs font-mono text-[#7D6F64]">NORMATIVA SEC / RIC VIGENTE</span>
          </div>

          <h2 class="display-md text-[#1A1513] mb-3">{s.title}</h2>
          <p class="body-base text-[#332B26] mb-6">{s.summary}</p>

          <div class="border-t border-[#E6DDD5] pt-6 mb-6">
            <h3 class="title-sm text-[#1A1513] mb-4">Alcance de los trabajos:</h3>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm text-[#7D6F64]">
              {s.details.map(item => (
                <li class="flex items-start gap-2">
                  <span class="text-[#B4470F] font-bold">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="flex items-center gap-4 pt-2">
            <Button href={`/contacto?servicio=${encodeURIComponent(s.title)}`} variant="primary" className="!h-11 !text-sm">
              Cotizar esta especialidad
            </Button>
          </div>
        </section>
      ))}
    </div>
  </div>
</Layout>
