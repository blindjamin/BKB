---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Card from '../components/ui/Card.astro';
import { SITE, QUOTE_ENDPOINT } from '../config/site';

const roles = [
  {
    title: 'Técnico / Ingeniero en Automatización y PLC',
    type: 'Terreno & Taller · Tiempo Completo',
    requirements: 'Experiencia demostrable en programación de autómatas Siemens / Schneider y comisionamiento en faena.'
  },
  {
    title: 'Maestro Mayor Electricista (Certificación SEC)',
    type: 'Faenas Industriales · Turnos',
    requirements: 'Licencia SEC vigente, dominio de curvado de canalizaciones, tendido de cables y armado de tableros TDF.'
  },
  {
    title: 'Armador de Tableros Eléctricos Industriales',
    type: 'Taller de Montaje · Valparaíso',
    requirements: 'Lectura fluida de planos unilineales, cableado prolijo de control y fuerza, y pruebas de continuidad.'
  }
];

const isEndpointAvailable = Boolean(QUOTE_ENDPOINT);
---

<Layout 
  title="Trabaja con Nosotros"
  description="Únete al equipo técnico de BKB Obras Eléctricas & Servicios. Convocatorias para ingenieros eléctricos, maestros y técnicos."
  headerMode="solid"
>
  <div class="bg-page py-16 border-b border-card-border">
    <div class="max-w-[var(--bkb-container)] mx-auto px-5 sm:px-10">
      <SectionHeading eyebrow="Oportunidades Laborales" title="Únete a Nuestro<br/>Equipo Técnico" />
      <p class="text-[15.5px] leading-relaxed text-muted max-w-[60ch] m-0">
        Buscamos profesionales y técnicos comprometidos con la seguridad en faena, la excelencia en el montaje y el aprendizaje continuo en obras industriales de envergadura.
      </p>
    </div>
  </div>

  <div class="max-w-[var(--bkb-container)] mx-auto px-5 sm:px-10 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- CONVOCATORIAS ABIERTAS -->
      <div class="flex flex-col gap-6">
        <h2 class="font-display font-bold text-[24px] text-main m-0">Perfiles en Búsqueda</h2>
        
        <div class="flex flex-col gap-4">
          {roles.map(r => (
            <Card>
              <h3 class="font-display font-bold text-[16px] text-main m-0 mb-1">{r.title}</h3>
              <span class="font-mono text-[11px] font-semibold tracking-wider text-salmon-500 uppercase block mb-3">{r.type}</span>
              <p class="text-[14px] text-muted m-0">{r.requirements}</p>
            </Card>
          ))}
        </div>

        <Card class="bg-salmon-500/5 border-salmon-500/20">
          <h4 class="font-display font-bold text-[15px] text-main m-0 mb-3">¿Qué ofrecemos?</h4>
          <ul class="m-0 p-0 list-none flex flex-col gap-2 text-[13.5px] text-muted">
            <li class="flex gap-2"><span class="text-salmon-500">✓</span> Contrato de trabajo formal con estabilidad.</li>
            <li class="flex gap-2"><span class="text-salmon-500">✓</span> Estándares estrictos de seguridad y EPP.</li>
            <li class="flex gap-2"><span class="text-salmon-500">✓</span> Capacitaciones continuas en normas SEC.</li>
            <li class="flex gap-2"><span class="text-salmon-500">✓</span> Seguro complementario contra accidentes.</li>
          </ul>
        </Card>
      </div>

      <!-- FORMULARIO DE POSTULACIÓN / CV -->
      <div class="lg:col-span-2">
        <Card>
          <div class="mb-6">
            <h2 class="font-display font-bold text-[24px] text-main m-0 mb-2">Envío de Antecedentes y CV</h2>
            <p class="text-[13px] text-muted m-0">Los campos marcados con (*) son obligatorios para evaluar su postulación.</p>
          </div>

          <form action={QUOTE_ENDPOINT} method="POST" enctype="multipart/form-data" class="flex flex-col gap-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="flex flex-col gap-1.5">
                <label for="cv-nombre" class="text-[13px] font-semibold text-main">Nombre completo *</label>
                <input type="text" id="cv-nombre" name="nombre" required class="h-[46px] px-4 rounded-input bg-input border border-input-border text-main text-[14.5px] focus:outline-none focus:border-salmon-500 focus:ring-1 focus:ring-salmon-500 transition-colors" />
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="cv-rut" class="text-[13px] font-semibold text-main">RUT *</label>
                <input type="text" id="cv-rut" name="rut" required placeholder="12.345.678-9" class="h-[46px] px-4 rounded-input bg-input border border-input-border text-main font-mono text-[14.5px] focus:outline-none focus:border-salmon-500 focus:ring-1 focus:ring-salmon-500 transition-colors" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="flex flex-col gap-1.5">
                <label for="cv-email" class="text-[13px] font-semibold text-main">Correo electrónico *</label>
                <input type="email" id="cv-email" name="email" required class="h-[46px] px-4 rounded-input bg-input border border-input-border text-main text-[14.5px] focus:outline-none focus:border-salmon-500 focus:ring-1 focus:ring-salmon-500 transition-colors" />
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="cv-telefono" class="text-[13px] font-semibold text-main">Teléfono móvil *</label>
                <input type="tel" id="cv-telefono" name="telefono" required class="h-[46px] px-4 rounded-input bg-input border border-input-border text-main font-mono text-[14.5px] focus:outline-none focus:border-salmon-500 focus:ring-1 focus:ring-salmon-500 transition-colors" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="flex flex-col gap-1.5">
                <label for="cv-area" class="text-[13px] font-semibold text-main">Área de postulación *</label>
                <select id="cv-area" name="area" required class="h-[46px] px-4 rounded-input bg-input border border-input-border text-main text-[14.5px] focus:outline-none focus:border-salmon-500 focus:ring-1 focus:ring-salmon-500 transition-colors appearance-none">
                  <option value="" disabled selected>Seleccione un área...</option>
                  <option value="automatizacion">Automatización / Programación PLC</option>
                  <option value="electricista">Maestro Electricista / Montajista</option>
                  <option value="tablerista">Armador de Tableros Eléctricos</option>
                  <option value="ingenieria">Ingeniero de Proyectos / Dibujante</option>
                  <option value="practica">Práctica Profesional</option>
                </select>
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="cv-licencia" class="text-[13px] font-semibold text-main">Licencia SEC</label>
                <select id="cv-licencia" name="licencia_sec" class="h-[46px] px-4 rounded-input bg-input border border-input-border text-main text-[14.5px] focus:outline-none focus:border-salmon-500 focus:ring-1 focus:ring-salmon-500 transition-colors appearance-none">
                  <option value="ninguna">No poseo licencia SEC</option>
                  <option value="clase-a">SEC Clase A</option>
                  <option value="clase-b">SEC Clase B</option>
                  <option value="clase-c">SEC Clase C</option>
                  <option value="clase-d">SEC Clase D</option>
                </select>
              </div>
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="cv-file" class="text-[13px] font-semibold text-main">Adjuntar Curriculum (PDF máx. 5 MB) *</label>
              <input type="file" id="cv-file" name="curriculum" accept=".pdf" required class="w-full px-4 py-3 rounded-input border border-input-border bg-input text-main text-sm file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-[12px] file:font-semibold file:bg-salmon-500/10 file:text-salmon-500 hover:file:bg-salmon-500/20 file:cursor-pointer file:transition-colors focus:outline-none focus:border-salmon-500 focus:ring-1 focus:ring-salmon-500" />
            </div>

            <!-- AVISO LEGAL LEY 21.719 -->
            <div class="bg-input border border-input-border rounded-md p-4 flex flex-col gap-3 mt-2">
              <span class="text-[13px] font-semibold text-main">Consentimiento de Tratamiento de Datos (Ley 21.719):</span>
              <p class="text-[12.5px] text-muted m-0 leading-relaxed">
                Los datos personales y documentos laborales proporcionados serán tratados por BKB con la exclusiva finalidad de evaluar su idoneidad en procesos de selección de personal presentes y futuros, durante un plazo máximo de retención de 12 meses.
              </p>
              <div class="flex items-start gap-3 mt-1">
                <input type="checkbox" id="consentimiento-cv" name="consentimiento" required class="mt-1 w-4 h-4 rounded-sm border-input-border bg-input text-salmon-500 focus:ring-salmon-500 cursor-pointer" />
                <label for="consentimiento-cv" class="text-[12.5px] text-main font-medium cursor-pointer leading-snug">
                  Consiento expresamente el tratamiento de mis datos personales según los términos descritos y la política de privacidad.
                </label>
              </div>
            </div>

            <button 
              type="submit" 
              class="mt-4 flex items-center justify-center h-[52px] rounded-pill bg-salmon-500 text-white font-semibold text-[15.5px] transition-all hover:bg-salmon-700 hover:-translate-y-0.5 focus:outline-none focus-visible:outline-[3px] focus-visible:outline-salmon-500 focus-visible:outline-offset-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:translate-y-0"
              disabled={!isEndpointAvailable}
            >
              Enviar Postulación &rarr;
            </button>
            
            {!isEndpointAvailable && (
              <div class="mt-2 text-[12.5px] text-warning bg-warning/10 border border-warning/30 p-3 rounded-md text-center font-medium">
                Formulario en habilitación. Escríbenos a <a href={`mailto:${SITE.email}`} class="underline hover:text-salmon-500">{SITE.email}</a>
              </div>
            )}
          </form>
        </Card>
      </div>
    </div>
  </div>
</Layout>
