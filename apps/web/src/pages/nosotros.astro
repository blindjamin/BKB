---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

const pillars = [
  {
    title: 'Rigor Normativo SEC',
    desc: 'Contamos con certificación SEC Clase A, habilitada para proyectar y ejecutar instalaciones eléctricas de cualquier potencia sin restricciones legales ni técnicas.'
  },
  {
    title: 'Seguridad en Faena & Cero Daños',
    desc: 'Protocolos estrictos de bloqueo de energías (LOTO), análisis de trabajo seguro (AST) y uso riguroso de EPP dieléctrico certificado.'
  },
  {
    title: 'Taller Propio de Integración',
    desc: 'Armado, cableado y pruebas de banco de tableros eléctricos en maestranza propia antes de su despacho a obra, asegurando tiempos mínimos de montaje en faena.'
  },
  {
    title: 'Trazabilidad Documental',
    desc: 'Cada conductor, interruptor y barraje cuenta con memoria técnica, certificado de calidad y respaldo en nuestro portal documental para clientes.'
  }
];

const clients = [
  { name: 'Empresas Sanitarias & Tratamiento de Agua', type: 'Infraestructura Crítica' },
  { name: 'Plantas Agroindustriales & Alimentos', type: 'Procesos Continuos' },
  { name: 'Centros de Distribución & Logística', type: 'Comercial & Fuerza' },
  { name: 'Maestranzas & Metalmecánica Pesada', type: 'Media Tensión' },
];
---

<Layout 
  title="Nosotros & Clientes"
  description="Conozca BKB Obras Eléctricas y Servicios: más de 25 años de trayectoria como contratista eléctrico industrial en Chile."
>
  <div class="bg-[#FBF8F5] py-16 border-b border-[#E6DDD5]">
    <div class="container-bkb">
      <span class="text-xs font-mono font-bold tracking-wider text-[#B4470F] uppercase">Trayectoria & Compromiso</span>
      <h1 class="display-lg text-[#1A1513] mt-2 mb-4">Ingeniería con Experiencia en Terreno</h1>
      <p class="body-base text-[#7D6F64] max-w-3xl">
        Desde 1999 resolvemos requerimientos eléctricos y de automatización para mandantes industriales que exigen continuidad de servicio, cumplimiento estricto de plazos y apego a la normativa chilena.
      </p>
    </div>
  </div>

  <div class="container-bkb py-16">
    <!-- HISTORIA Y VALORES -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-20">
      <div>
        <h2 class="display-md text-[#1A1513] mb-6">Más de dos décadas conectando potencia y control</h2>
        <div class="space-y-4 body-base text-[#332B26] leading-relaxed">
          <p>
            BKB nació como un equipo técnico especializado en el montaje de tableros de control y mantenimiento industrial. A lo largo de más de 25 años hemos crecido junto a nuestros clientes, consolidándonos como contratistas integrales capaces de abordar desde obras civiles eléctricas subterráneas hasta subestaciones de media tensión y redes SCADA de alta complejidad.
          </p>
          <p>
            Entendemos que en la industria cada hora de detención no programada se traduce en pérdidas operativas críticas. Por eso nuestro foco no está solo en el montaje, sino en la confiabilidad del diseño y en la entrega de documentación técnica impecable.
          </p>
        </div>
      </div>
      <div class="card-bkb bg-[#FAF6F2] border-[#sand-200] p-8">
        <h3 class="font-display text-xl font-bold text-[#1A1513] mb-4">Credenciales Técnicas</h3>
        <ul class="space-y-4 text-sm text-[#7D6F64]">
          <li class="flex items-start gap-3">
            <span class="badge badge-sec-ok shrink-0">SEC A</span>
            <span>Instalador Autorizado por la Superintendencia de Electricidad y Combustibles de Chile sin límite de potencia.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="badge badge-sec-info shrink-0">TE1</span>
            <span>Gestión digital directa en plataforma SEC para tramitación ágil de declaraciones eléctricas provisorias y definitivas.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="badge badge-sec-warning shrink-0">LOTO</span>
            <span>Personal técnico capacitado bajo estándares internacionales de bloqueo de energías peligrosas y seguridad ocupacional.</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- PILARES DE TRABAJO -->
    <div class="mb-20">
      <h2 class="display-md text-[#1A1513] mb-8 text-center">Nuestros Pilares de Ejecución</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {pillars.map(p => (
          <div class="card-bkb p-6">
            <h3 class="font-display text-lg font-bold text-[#1A1513] mb-2">{p.title}</h3>
            <p class="body-sm text-[#7D6F64] leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- SECTORES QUE ATENDEMOS -->
    <div class="card-bkb bg-[#1A1513] text-white p-10 lg:p-12">
      <div class="max-w-2xl mb-8">
        <h2 class="display-md text-white mb-3">Sectores Industriales con Obras BKB</h2>
        <p class="text-[#BDB0A4] text-sm leading-relaxed">
          Nuestras soluciones operan en instalaciones donde la continuidad del suministro y la seguridad humana son prioritarias.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {clients.map(c => (
          <div class="bg-[#261E1A] p-4 rounded-lg border border-[#3D322B]">
            <span class="text-xs font-mono text-[#F27A38] block mb-1">{c.type}</span>
            <span class="text-sm font-semibold text-white">{c.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
